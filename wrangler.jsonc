{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amnesia",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["python_workers"],
  // Publicação e Access serão configurados no incremento 5.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amnesia",
      // Identificador fictício: suficiente para desenvolvimento local.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
